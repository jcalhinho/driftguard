# DriftGuard — service configuration
# Copy to .env and fill in (see SETUP.md)

GITHUB_APP_ID=123456
GITHUB_APP_PRIVATE_KEY_PATH=./deploy/driftguard-key.pem
# Required: webhooks are rejected (503) when this is unset.
GITHUB_WEBHOOK_SECRET=change-me-generate-with-openssl-rand-hex-32

# Optional: alternative rules file
# DRIFTGUARD_RULES=./my-rules.yaml
